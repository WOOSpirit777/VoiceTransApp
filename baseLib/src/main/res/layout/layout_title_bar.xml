<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="onclick"
            type="android.view.View.OnClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:background="@color/transparent"
        android:layout_height="58dp"
        android:minHeight="44dp">

        <ImageView
            android:id="@+id/title_bar_back_iv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:onClick="@{onclick}"
            android:paddingHorizontal="8dp"
            android:paddingVertical="14dp"
            android:src="@drawable/ic_title_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_bar_left_cancel_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:onClick="@{onclick}"
            android:padding="10dp"
            android:textColor="#000"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="" />

        <TextView
            android:id="@+id/title_bar_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="80dp"
            android:textColor="#000000"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_bar_right_confirm_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:onClick="@{onclick}"
            android:padding="10dp"
            android:textColor="@color/color_333333"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="" />

        <ImageView
            android:id="@+id/title_bar_confirm_left_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="@{onclick}"
            android:padding="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/title_bar_confirm_right_iv"
            app:layout_constraintRight_toLeftOf="@id/title_bar_confirm_right_iv"
            app:layout_constraintTop_toTopOf="@id/title_bar_confirm_right_iv" />

        <ImageView
            android:id="@+id/title_bar_confirm_right_iv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:onClick="@{onclick}"
            android:paddingHorizontal="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
