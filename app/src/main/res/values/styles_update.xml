<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="UpdateDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="UpdateDialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_down_in</item>
        <item name="android:windowExitAnimation">@anim/slide_up_out</item>
    </style>
</resources>
